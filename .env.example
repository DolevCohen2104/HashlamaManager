# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_SHARED_CALENDAR_ID: The public Google Calendar ID for the app's schedule (e.g., your-calendar-id@group.calendar.google.com).
# Important: The calendar MUST be made public in Google Calendar settings for this to work.
VITE_SHARED_CALENDAR_ID=""

# VITE_GOOGLE_CALENDAR_API_KEY: Google Cloud API Key with Google Calendar API enabled.
VITE_GOOGLE_CALENDAR_API_KEY=""

SUPABASE_PASSWORD=neo1FJjw3Y49KpDf